# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# --- Neon (https://console.neon.tech -> your project -> Connect)
# Pooled connection string (host contains "-pooler") for the API:
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct connection string (no "-pooler") for migrations:
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# auto = Neon serverless driver for *.neon.tech, node-postgres otherwise (e.g. docker compose Postgres)
DB_DRIVER=auto
DB_POOL_MAX=10

# --- Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- HTTP
CORS_ORIGINS=*
TRUST_PROXY=1
DOCS_ENABLED=true

# --- Background jobs (reminders, digest, cleanup)
JOBS_ENABLED=true
REMINDER_INTERVAL_MS=30000
DIGEST_INTERVAL_MS=60000

# --- Push notifications (Firebase Cloud Messaging)
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Paste the JSON on one line, or base64 encode it: base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT=
